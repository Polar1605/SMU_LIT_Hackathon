# Copy this file to `.env.local` and fill in your key:
#
#   cp .env.local.example .env.local
#
# The key is only needed to extract a contract that is NOT already in the
# on-disk cache (data/cache, data/cuad/cache) — both bundled corpora are
# cached, so `npm run cuad:pipeline` and `npm run pipeline` run with no key.
# You need a key only to run the pipeline over your own folder of contracts.
#
# A cache miss with no key throws a clear error rather than inventing an
# extraction.

OPENAI_API_KEY=
